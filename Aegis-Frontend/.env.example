VITE_API_URL=http://localhost:5000

# Google Maps (Donor map -> Google toggle-ku mattum thevai).
# Key illana OSM default-a work aagum, Google click panna "not configured" message varum.
# Google Cloud Console -> Maps JavaScript API ON -> API key create panni inga paste pannu.
# Pinna `npm run dev`-a restart pannu (Vite-ku restart must).
# VITE_GOOGLE_MAPS_KEY=
